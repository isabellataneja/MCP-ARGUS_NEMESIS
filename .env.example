# Supabase (service role key is server-only; never expose to clients or tool output)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for Authorization: Bearer on POST /mcp and POST /tools/call
MCP_BEARER_TOKEN=

# Read-only Postgres connection to the `normandy` source database — used only
# by the CRONUS note tools (cronus_getUpdatedNotes / cronus_getNoteContentBulk).
# MUST be a read-only role; the server only ever SELECTs from it. Optional:
# without it the server boots fine and only the cronus tools error per-call.
NORMANDY_DATABASE_URL=

# HTTP port (Railway sets PORT automatically)
PORT=8080

# Region that tools default to when caller does not pass `region`.
# Must be one of: AX-BD-Dhaka, AX-IN-Bangalore, IN-IDS-Mohali, IN-IDS-Noida, SL-Medsource-Colombo, AX-US-San Francisco
MCP_DEFAULT_REGION=AX-BD-Dhaka

# Set to 'true' AFTER running the SQL migration that adds a `region` column to bd_holidays.
MCP_HOLIDAYS_HAVE_REGION=false

# Quality variance sync cron (services/quality-variance-sync). Default false.
# Keep false until Phase 2 ships the real sync impl (warehouse creds + variance compute).
# When true, the server registers `0 4 * * * UTC` to call syncQualityVariance().
# Phase 1.6 wiring is dormant: with this flag set true before Phase 2 lands,
# the stub throws 'Not implemented' on each fire (logged, server keeps running).
QUALITY_VARIANCE_CRON_ENABLED=false
